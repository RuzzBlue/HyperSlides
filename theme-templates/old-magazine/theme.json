{
  "id": "old-magazine",
  "name": "Old Magazine",
  "fonts": {
    "display": "\"Playfair Display\", \"Times New Roman\", serif",
    "body": "\"Source Serif 4\", Georgia, serif",
    "google": "https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;700;800&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600;8..60,700&display=swap"
  },
  "fontSizeBase": "17px",
  "typeScale": {
    "h1": "2.6rem",
    "h2": "1.7rem",
    "h3": "1.25rem",
    "body": "17px"
  },
  "accent": "#8b3a2b",
  "quiz": "#3d5a80",
  "lab": "#5c4a3a",
  "background": {
    "light": {
      "type": "gradient",
      "value": "linear-gradient(180deg, #f3e7d3 0%, #efe2cb 40%, #e8d7bc 100%)"
    },
    "dark": {
      "type": "gradient",
      "value": "linear-gradient(180deg, #2a2218 0%, #1c1711 100%)"
    }
  },
  "backgrounds": {
    "default": {
      "light": {
        "type": "gradient",
        "value": "linear-gradient(180deg, #f3e7d3 0%, #efe2cb 40%, #e8d7bc 100%)"
      },
      "dark": {
        "type": "gradient",
        "value": "linear-gradient(180deg, #2a2218 0%, #1c1711 100%)"
      }
    },
    "title": {
      "light": {
        "type": "gradient",
        "value": "radial-gradient(ellipse 80% 50% at 50% 0%, #f7ecda 0%, #e8d7bc 70%)"
      },
      "dark": {
        "type": "gradient",
        "value": "radial-gradient(ellipse 80% 50% at 50% 0%, #3a2e20 0%, #1c1711 70%)"
      }
    },
    "section": {
      "light": {
        "type": "gradient",
        "value": "linear-gradient(90deg, #e6d3b4 0%, #f0e2cb 50%, #e6d3b4 100%)"
      },
      "dark": {
        "type": "gradient",
        "value": "linear-gradient(90deg, #241c14 0%, #2e241a 50%, #241c14 100%)"
      }
    },
    "accent": {
      "light": {
        "type": "gradient",
        "value": "linear-gradient(180deg, #f0dcc0 0%, #e8c9a8 100%)"
      },
      "dark": {
        "type": "gradient",
        "value": "linear-gradient(180deg, #3a281c 0%, #1c1711 100%)"
      }
    },
    "dark": {
      "light": {
        "type": "gradient",
        "value": "linear-gradient(180deg, #2c2118 0%, #1a140f 100%)"
      },
      "dark": { "type": "color", "value": "#120e0a" }
    }
  },
  "watermark": {
    "enabled": false,
    "kind": "text",
    "value": "ARCHIVE",
    "opacity": 0.07,
    "size": "15vmin",
    "rotateDeg": -12,
    "position": "center",
    "repeat": "single"
  },
  "pageNumber": {
    "enabled": true,
    "position": "bottom-center",
    "format": "— {n} —",
    "opacity": 0.55
  },
  "cssFile": "theme.css"
}
