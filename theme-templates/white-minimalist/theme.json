{
  "id": "white-minimalist",
  "name": "White Minimalist",
  "fonts": {
    "display": "\"DM Sans\", system-ui, sans-serif",
    "body": "\"DM Sans\", system-ui, sans-serif",
    "google": "https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&display=swap"
  },
  "fontSizeBase": "15.5px",
  "typeScale": {
    "h1": "2rem",
    "h2": "1.4rem",
    "h3": "1.1rem",
    "body": "15.5px"
  },
  "accent": "#171717",
  "quiz": "#2563eb",
  "lab": "#0f766e",
  "background": {
    "light": { "type": "color", "value": "#ffffff" },
    "dark": { "type": "color", "value": "#0a0a0a" }
  },
  "backgrounds": {
    "default": {
      "light": { "type": "color", "value": "#ffffff" },
      "dark": { "type": "color", "value": "#0a0a0a" }
    },
    "title": {
      "light": {
        "type": "gradient",
        "value": "linear-gradient(180deg, #fafafa 0%, #ffffff 40%, #ffffff 100%)"
      },
      "dark": {
        "type": "gradient",
        "value": "linear-gradient(180deg, #171717 0%, #0a0a0a 100%)"
      }
    },
    "section": {
      "light": { "type": "color", "value": "#f5f5f5" },
      "dark": { "type": "color", "value": "#171717" }
    },
    "accent": {
      "light": {
        "type": "gradient",
        "value": "linear-gradient(135deg, #fafafa 0%, #e5e5e5 100%)"
      },
      "dark": {
        "type": "gradient",
        "value": "linear-gradient(135deg, #262626 0%, #0a0a0a 100%)"
      }
    },
    "dark": {
      "light": { "type": "color", "value": "#171717" },
      "dark": { "type": "color", "value": "#000000" }
    }
  },
  "watermark": {
    "enabled": false,
    "kind": "text",
    "value": "DRAFT",
    "opacity": 0.05,
    "size": "16vmin",
    "rotateDeg": -18,
    "position": "center",
    "repeat": "single"
  },
  "pageNumber": {
    "enabled": true,
    "position": "bottom-center",
    "format": "{n}",
    "opacity": 0.4
  },
  "cssFile": "theme.css"
}
