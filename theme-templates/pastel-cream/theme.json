{
  "id": "pastel-cream",
  "name": "Pastel Cream",
  "fonts": {
    "display": "\"Fraunces\", Georgia, serif",
    "body": "\"Nunito Sans\", system-ui, sans-serif",
    "google": "https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,650&family=Nunito+Sans:wght@400;500;600;700&display=swap"
  },
  "fontSizeBase": "16px",
  "typeScale": {
    "h1": "2.2rem",
    "h2": "1.45rem",
    "h3": "1.15rem",
    "body": "16px"
  },
  "accent": "#c4785a",
  "quiz": "#6a8faf",
  "lab": "#7a9e7e",
  "background": {
    "light": {
      "type": "gradient",
      "value": "linear-gradient(180deg, #fbf6ef 0%, #f7efe4 45%, #f3e8da 100%)"
    },
    "dark": {
      "type": "gradient",
      "value": "linear-gradient(180deg, #2a2420 0%, #1e1a17 100%)"
    }
  },
  "backgrounds": {
    "default": {
      "light": {
        "type": "gradient",
        "value": "linear-gradient(180deg, #fbf6ef 0%, #f7efe4 45%, #f3e8da 100%)"
      },
      "dark": {
        "type": "gradient",
        "value": "linear-gradient(180deg, #2a2420 0%, #1e1a17 100%)"
      }
    },
    "title": {
      "light": {
        "type": "gradient",
        "value": "radial-gradient(ellipse 85% 55% at 50% -5%, #fde8d8 0%, transparent 55%), linear-gradient(180deg, #fbf6ef 0%, #f5ebe0 100%)"
      },
      "dark": {
        "type": "gradient",
        "value": "radial-gradient(ellipse 85% 55% at 50% -5%, rgba(196,120,90,0.2) 0%, transparent 55%), linear-gradient(180deg, #2f2823 0%, #1e1a17 100%)"
      }
    },
    "section": {
      "light": {
        "type": "gradient",
        "value": "linear-gradient(135deg, #f3e8da 0%, #e8f0ea 50%, #fbf6ef 100%)"
      },
      "dark": {
        "type": "gradient",
        "value": "linear-gradient(135deg, #2a2420 0%, #243028 50%, #1e1a17 100%)"
      }
    },
    "accent": {
      "light": {
        "type": "gradient",
        "value": "linear-gradient(180deg, #fde8d8 0%, #f7efe4 100%)"
      },
      "dark": {
        "type": "gradient",
        "value": "linear-gradient(180deg, #3a2e28 0%, #1e1a17 100%)"
      }
    },
    "dark": {
      "light": {
        "type": "gradient",
        "value": "linear-gradient(160deg, #3d342e 0%, #2a2420 100%)"
      },
      "dark": { "type": "color", "value": "#171411" }
    }
  },
  "watermark": {
    "enabled": false,
    "kind": "text",
    "value": "SAMPLE",
    "opacity": 0.06,
    "size": "14vmin",
    "rotateDeg": -20,
    "position": "bottom-right",
    "repeat": "single"
  },
  "pageNumber": {
    "enabled": true,
    "position": "bottom-left",
    "format": "{n} / {total}",
    "opacity": 0.5
  },
  "cssFile": "theme.css"
}
